# Перед запуском скопируйте файл в .env и задайте уникальные значения.
POSTGRES_DB=orders
POSTGRES_USER=orders
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-admin-password
ACCESS_TOKEN_MINUTES=60
TABLE_ACCESS_HOURS=12
UPLOADS_DIR=/data/uploads
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500

# Local-only development. Production requires HTTPS and false.
PUBLIC_ORIGIN=http://localhost:8080
ALLOW_INSECURE_LOCAL=true
QR_TOKEN_SECONDS=1200
GUEST_SESSION_SECONDS=10800
